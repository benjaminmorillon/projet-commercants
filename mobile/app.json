{
  "expo": {
    "name": "Projet Commerçant",
    "slug": "projet-commercant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.projetcommercant.app"
    },
    "android": {
      "package": "fr.projetcommercant.app",
      "adaptiveIcon": {
        "backgroundColor": "#100d1b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "projetcommercant",
    "backgroundColor": "#100d1b",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Projet Commerçant se sert de ta position pour te montrer les commerces autour de toi, du plus proche au plus loin. Elle n'est jamais envoyée au serveur."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Projet Commerçant se sert de l'appareil photo pour scanner le code que le client présente en arrivant dans le commerce.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "apiUrl": ""
    }
  }
}
